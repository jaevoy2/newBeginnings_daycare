# Set these in your host (e.g. Vercel > Project > Settings > Environment Variables)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Optional
NOTIFY_TO=francis@creativedevlabs.com
# Must be a sender on a domain verified in Resend (onboarding@resend.dev only delivers to your own Resend account email)
NOTIFY_FROM=Site Visits <visits@yourdomain.com>
# Only accept visit reports from your live site
ALLOWED_ORIGIN=https://your-live-domain.com
